# ─────────────────────────────────────────────────────────────────────────────
# .env — EmiTech producción (DigitalOcean)
# Copia como .env en el servidor y llena con valores reales
# NUNCA subas este archivo a GitHub
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos (Docker interno) ───────────────────────────────────────────
POSTGRES_DB=emitech
POSTGRES_USER=emitech
POSTGRES_PASSWORD=CAMBIA_ESTO_clave_segura

# La API se conecta al contenedor postgres (no cambiar si usas Docker Compose)
DATABASE_URL=postgresql://emitech:CAMBIA_ESTO_clave_segura@postgres:5432/emitech

# ── Redis (Docker interno) ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Seguridad JWT ─────────────────────────────────────────────────────────────
# Genera con: openssl rand -base64 64
JWT_SECRET=GENERA_CLAVE_ALEATORIA_MUY_LARGA_AQUI

# ── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# Token que tú inventas — debe coincidir con lo configurado en Meta Developers
META_WEBHOOK_VERIFY_TOKEN=emitech_webhook_2025
# App Secret: developers.facebook.com → Tu app → Configuración básica
META_APP_SECRET=05ee0201e6f0951225eb4a8e9af1755f

# ── OpenRouter (IA fallback del bot) ─────────────────────────────────────────
OPENROUTER_API_KEY=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

# ── Wompi (pagos Colombia) ────────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=pub_prod_XXXX
WOMPI_PRIVATE_KEY=prv_prod_XXXX
WOMPI_EVENTS_SECRET=prod_integrity_XXXX

# ── URLs públicas ─────────────────────────────────────────────────────────────
# Reemplaza con la IP de tu droplet (o dominio cuando lo tengas)
WEB_URL=http:http://64.227.16.199
NEXT_PUBLIC_API_URL=
